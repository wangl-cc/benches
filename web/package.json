{
  "name": "rust-benchmark-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10 <12"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "bench": "node --experimental-strip-types scripts/bench-run.ts",
    "publish": "node --experimental-strip-types scripts/bench-run-publish.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "auth": "node --experimental-strip-types scripts/bench-auth.ts",
    "seed": "node --experimental-strip-types scripts/seed-runs.ts",
    "dev": "pnpm run migrate -- --local && pnpm --parallel --filter benchmark-explorer-site --filter benchmark-explorer-worker dev",
    "build": "pnpm --dir site run build",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "typecheck:api": "tsc -p tsconfig.bench-api.json",
    "test:api": "node --experimental-strip-types --test scripts/publish.test.ts",
    "verify": "node --experimental-strip-types scripts/verify.ts"
  }
}
