{
  "name": "rust-benchmark-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "bench:run": "node --experimental-strip-types scripts/bench-run.ts",
    "bench:auth": "node --experimental-strip-types scripts/bench-auth.ts",
    "bench:publish": "node --experimental-strip-types scripts/publish.ts",
    "bench:run:publish": "node --experimental-strip-types scripts/bench-run-publish.ts",
    "bench:seed": "node --experimental-strip-types scripts/seed-runs.ts",
    "dev": "pnpm worker:dev",
    "dev:8788": "pnpm --dir worker dev:8788",
    "dev:site": "pnpm --dir site run dev",
    "build": "pnpm --dir site run build",
    "build:site": "pnpm --dir site run build:site",
    "typecheck:api": "pnpm --dir worker exec tsc -p ../tsconfig.bench-api.json",
    "test:api": "node --experimental-strip-types --test scripts/publish.test.ts",
    "worker:dev": "pnpm --dir worker dev",
    "worker:deploy": "pnpm --dir worker deploy:production",
    "worker:migrate:local": "pnpm --dir worker migrate:local",
    "worker:migrate": "pnpm --dir worker migrate:remote"
  }
}
